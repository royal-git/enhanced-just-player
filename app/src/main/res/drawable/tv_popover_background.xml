<?xml version="1.0" encoding="utf-8"?>
<!-- Dark glass: in HDR/Dolby Vision output the Shield draws interface white at full brightness, so a light
     panel glares. Android 11 has no live blur, hence the nearly opaque fill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#EB1C1C21" />
    <stroke android:width="1dp" android:color="#1FFFFFFF" />
    <corners android:radius="18dp" />
</shape>
