<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

  <FrameLayout android:id="@+id/exo_controls_background"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_gravity="center"
      android:background="@drawable/controls_scrim"
      android:layoutDirection="ltr">
  </FrameLayout>

  <!-- tvOS layout, anchored to the bottom: a menu grows upwards above its icon and the Info sheet
       grows below the tabs, so both push the title and timeline up instead of covering them.
       No animateLayoutChanges: its bounds animation briefly squeezes rows to zero height, and Android
       drops focus from a zero-sized view. The activity animates with translation and alpha instead. -->
  <LinearLayout android:id="@+id/control_group"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom"
      android:paddingStart="@dimen/tv_controls_inset"
      android:paddingEnd="@dimen/tv_controls_inset"
      android:paddingBottom="36dp"
      android:clipChildren="false"
      android:clipToPadding="false"
      android:orientation="vertical"
      android:layoutDirection="ltr">

    <LinearLayout android:id="@+id/popover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginBottom="12dp"
        android:minWidth="300dp"
        android:padding="8dp"
        android:background="@drawable/tv_popover_background"
        android:orientation="vertical"
        android:visibility="gone">

      <TextView android:id="@+id/popover_header"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingStart="12dp"
          android:paddingTop="6dp"
          android:paddingBottom="6dp"
          android:textColor="#8CFFFFFF"
          android:textSize="12sp"
          android:letterSpacing="0.1"
          android:fontFamily="@font/outfit_semibold" />

      <LinearLayout android:id="@+id/popover_list"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical" />

      <!-- More > Info: read-only details in three columns, so the card stays short on a wide screen.
           Focusable so focus stays in the menu; Back returns to More. -->
      <LinearLayout android:id="@+id/popover_info"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingStart="12dp"
          android:paddingEnd="12dp"
          android:paddingBottom="10dp"
          android:focusable="true"
          android:orientation="horizontal"
          android:visibility="gone">

        <TextView android:id="@+id/info_video" style="@style/TvInfoColumn" />
        <TextView android:id="@+id/info_audio" style="@style/TvInfoColumn" />
        <TextView android:id="@+id/info_subtitles" style="@style/TvInfoColumn" android:layout_marginEnd="0dp" />

      </LinearLayout>

      <!-- More > About: poster and title details. Focusable so focus stays in the menu; Back returns to More. -->
      <LinearLayout android:id="@+id/popover_about"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingStart="12dp"
          android:paddingEnd="12dp"
          android:paddingTop="2dp"
          android:paddingBottom="12dp"
          android:focusable="true"
          android:orientation="horizontal"
          android:visibility="gone">

        <ImageView android:id="@+id/about_poster"
            android:layout_width="104dp"
            android:layout_height="156dp"
            android:layout_marginEnd="20dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView android:id="@+id/about_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="560dp"
            android:lineSpacingMultiplier="1.2"
            android:fontFamily="@font/outfit_regular"
            android:textColor="#E6FFFFFF"
            android:textSize="15sp" />

      </LinearLayout>

    </LinearLayout>

    <!-- The small line above the title, as tvOS has it: the show and episode number for series, then the
         format badges and any audio warning. Hidden when it has nothing to say. -->
    <LinearLayout android:id="@+id/meta_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

      <TextView android:id="@+id/episode_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="14dp"
          android:fontFamily="@font/outfit_medium"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:textColor="#B3FFFFFF"
          android:textSize="16sp"
          android:visibility="gone" />

      <LinearLayout android:id="@+id/badge_row"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal" />

      <!-- Only shown as a warning: nothing is said when the best audio is playing -->
      <TextView android:id="@+id/summary_status"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:fontFamily="@font/outfit_medium"
          android:textColor="#FFFFD60A"
          android:textSize="14sp"
          android:visibility="gone" />

    </LinearLayout>

    <!-- The title, then the icons on the right; a long title truncates before the icons -->
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/title_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

      <TextView android:id="@+id/title_text"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginEnd="24dp"
          android:fontFamily="@font/outfit_semibold"
          android:textColor="#FFFFFFFF"
          android:textSize="28sp"
          android:maxLines="1"
          android:ellipsize="end"
          android:textDirection="locale"
          android:visibility="gone"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toStartOf="@id/icon_row"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent" />

      <LinearLayout android:id="@+id/icon_row"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent">

        <!-- Shown only when the stream says what is playing -->
        <ImageButton android:id="@+id/icon_about"
            style="@style/TvIconButton"
            android:contentDescription="@string/tv_about"
            android:nextFocusLeft="@id/icon_about"
            android:nextFocusUp="@id/icon_about"
            android:nextFocusDown="@id/exo_progress"
            android:src="@drawable/ic_tv_about"
            android:visibility="gone" />

        <ImageButton android:id="@+id/icon_subtitles"
            style="@style/TvIconButton"
            android:contentDescription="@string/tv_subtitles"
            android:nextFocusUp="@id/icon_subtitles"
            android:nextFocusDown="@id/exo_progress"
            android:src="@drawable/ic_tv_subtitles" />

        <ImageButton android:id="@+id/icon_audio"
            style="@style/TvIconButton"
            android:contentDescription="@string/tv_audio"
            android:nextFocusUp="@id/icon_audio"
            android:nextFocusDown="@id/exo_progress"
            android:src="@drawable/ic_tv_audio" />

        <ImageButton android:id="@+id/icon_more"
            style="@style/TvIconButton"
            android:contentDescription="@string/tv_more"
            android:nextFocusRight="@id/icon_more"
            android:nextFocusUp="@id/icon_more"
            android:nextFocusDown="@id/exo_progress"
            android:src="@drawable/ic_tv_more" />

      </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.brouken.player.CustomDefaultTimeBar android:id="@+id/exo_progress"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="10dp"
        android:nextFocusUp="@id/icon_subtitles"
        android:nextFocusDown="@id/exo_progress"
        app:bar_height="@dimen/exo_styled_progress_bar_height"
        app:bar_gravity="center"
        app:touch_target_height="28dp"
        app:scrubber_enabled_size="0dp"
        app:scrubber_disabled_size="0dp"
        app:scrubber_dragged_size="0dp"
        app:ad_marker_width="@dimen/marker_width"/>

    <FrameLayout android:id="@+id/time_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

      <!-- Media3 fills exo_position; the activity moves it to sit under the playhead -->
      <LinearLayout android:id="@+id/exo_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="start"
          android:layoutDirection="ltr">

        <TextView android:id="@+id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_medium"
            android:textColor="#D9FFFFFF"
            android:textSize="14sp" />

        <TextView android:id="@+id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

      </LinearLayout>

      <!-- Right end of the row under the timeline: the end time and time left. The elapsed time under the
           playhead stops short of this group. -->
      <LinearLayout android:id="@+id/time_right"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="end|center_vertical"
          android:gravity="center_vertical"
          android:orientation="horizontal">

        <TextView android:id="@+id/time_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_medium"
            android:textColor="#D9FFFFFF"
            android:textSize="14sp" />

      </LinearLayout>

    </FrameLayout>

    <!-- Media3 looks these up; on TV they stay hidden and More covers their actions -->
    <FrameLayout android:id="@+id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layoutDirection="ltr">

      <LinearLayout android:id="@+id/exo_basic_controls"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="end"
          android:visibility="gone"
          android:layoutDirection="ltr">

        <ImageButton android:id="@+id/exo_vr"
            style="@style/ExoStyledControls.Button.Bottom.VR"/>

        <ImageButton android:id="@+id/exo_shuffle"
            style="@style/ExoStyledControls.Button.Bottom.Shuffle"/>

        <ImageButton android:id="@+id/exo_repeat_toggle"
            style="@style/ExoStyledControls.Button.Bottom.RepeatToggle"/>

        <ImageButton android:id="@+id/exo_subtitle"
            style="@style/ExoStyledControls.Button.Bottom.CC"/>

        <ImageButton android:id="@+id/exo_settings"
            style="@style/ExoStyledControls.Button.Bottom.Settings"/>

        <ImageButton android:id="@+id/exo_fullscreen"
            style="@style/ExoStyledControls.Button.Bottom.FullScreen"/>

        <ImageButton android:id="@+id/exo_overflow_show"
            style="@style/ExoStyledControls.Button.Bottom.OverflowShow"/>

      </LinearLayout>

      <HorizontalScrollView android:id="@+id/exo_extra_controls_scroll_view"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="end"
          android:visibility="invisible">

        <LinearLayout android:id="@+id/exo_extra_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr">

          <ImageButton android:id="@+id/exo_overflow_hide"
              style="@style/ExoStyledControls.Button.Bottom.OverflowHide"/>

        </LinearLayout>

      </HorizontalScrollView>

    </FrameLayout>

  </LinearLayout>

  <LinearLayout android:id="@+id/exo_minimal_controls"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|end"
      android:layout_marginBottom="@dimen/exo_styled_minimal_controls_margin_bottom"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:visibility="gone"
      android:layoutDirection="ltr">

    <ImageButton android:id="@+id/exo_minimal_fullscreen"
        style="@style/ExoStyledControls.Button.Bottom.FullScreen"/>

  </LinearLayout>

  <!-- No centre button on TV: OK on the timeline plays and pauses. The spinner still shows while loading. -->
  <LinearLayout
      android:id="@+id/exo_center_controls"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:background="@android:color/transparent"
      android:gravity="center"
      android:padding="@dimen/exo_styled_controls_padding">

    <ImageButton android:id="@+id/delete"
        style="@style/ExoStyledControls.Button.Center.Secondary"
        android:src="@drawable/exo_styled_controls_delete"/>

    <ImageButton android:id="@+id/exo_prev"
        style="@style/ExoStyledControls.Button.Center.Previous"/>

    <include layout="@layout/exo_player_control_rewind_button" />

    <ImageButton android:id="@+id/exo_play_pause"
        style="@style/ExoStyledControls.Button.Center.PlayPause"
        android:visibility="gone"/>

    <ProgressBar android:id="@+id/loading"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"/>

    <include layout="@layout/exo_player_control_ffwd_button" />

    <ImageButton android:id="@+id/exo_next"
        style="@style/ExoStyledControls.Button.Center.Next"/>

    <ImageButton android:id="@+id/next"
        style="@style/ExoStyledControls.Button.Center.Secondary"
        android:src="@drawable/exo_styled_controls_next"/>

  </LinearLayout>

  <View android:id="@+id/exo_top"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:background="@color/exo_black_opacity_70"
      android:layout_gravity="top" />

  <View android:id="@+id/exo_left"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:background="@color/exo_black_opacity_70"
    android:layout_gravity="left" />

  <View android:id="@+id/exo_right"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:background="@color/exo_black_opacity_70"
      android:layout_gravity="right" />

</merge>
